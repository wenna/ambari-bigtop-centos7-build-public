[cluster-app]
name=EL7 cluster application RPM snapshot
baseurl=https://repo.prod.example.internal/snapshots/SNAPSHOT/yum-staging/
enabled=1
gpgcheck=1
repo_gpgcheck=1
sslverify=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-cluster

[cluster-runtime]
name=EL7 cluster runtime RPM snapshot
baseurl=https://repo.prod.example.internal/snapshots/SNAPSHOT/runtime-repo/
enabled=1
gpgcheck=1
repo_gpgcheck=1
sslverify=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-7
       file:///etc/pki/rpm-gpg/RPM-GPG-KEY-EPEL-7
       file:///etc/pki/rpm-gpg/RPM-GPG-KEY-cluster
