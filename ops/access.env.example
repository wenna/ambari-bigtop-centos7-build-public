# First-login account supplied by site IT. Its key stays on the control host.
BOOTSTRAP_USER=siteadmin
BOOTSTRAP_IDENTITY_FILE=$HOME/.ssh/site-bootstrap
# Verified known_hosts entries for all FQDNs and any initial IPs, at SSH_PORT.
# Set SSH_KNOWN_HOSTS, SSH_USER, SSH_PORT, INVENTORY and KIT_ROOT in site.env.
# The deployment private key path is SSH_IDENTITY_FILE in site.env.
# 0 reuses an existing key. 1 creates a dedicated local key if missing.
GENERATE_DEPLOY_KEY=0
