# Copy outside the read-only release and edit; this is trusted Bash input.
SSH_USER=clusterops
SSH_PORT=22
# Leave these empty to use the operator's normal OpenSSH configuration.
SSH_IDENTITY_FILE=
SSH_KNOWN_HOSTS=
# Explicit prepare runs on request; all skips OS preparation unless set to 1.
PREPARE_OS=0
BOOTSTRAP_INVENTORY=/etc/bigtop-deploy/bootstrap.csv
# These flags only affect prepare. Zero preserves site-provided hostname/DNS.
SET_HOSTNAME=0
MANAGE_ETC_HOSTS=0
KIT_ROOT=/srv/bigtop-kit
# Transfer the digest from the verified release through an independent channel.
MANIFEST_SHA256=REPLACE_WITH_SHA256_OF_ROOT_SHA256SUMS
INVENTORY=/etc/bigtop-deploy/hosts.csv
DATA_SITE=/etc/bigtop-deploy/site.json
SNAPSHOT=/var/lib/bigtop-deploy/site-001
# Optional assertion. The ambari-server inventory role selects the actual host.
AMBARI_FQDN=
# Allow the selected chrony server/peer by address or by a site DNS name.
NTP_SOURCES='ntp1.prod.example.internal ntp2.prod.example.internal'
MAX_CLOCK_OFFSET_SECONDS=0.5
# Space-separated actual mount points. Every host checks REQUIRED_MOUNTS.
# DataNode or NodeManager hosts additionally check WORKER_MOUNTS.
# Use '/' alone for single-volume sites, and leave WORKER_MOUNTS empty.
REQUIRED_MOUNTS='/ /data'
WORKER_MOUNTS='/disk1 /disk2'
# Per listed filesystem, in MiB. Select this threshold from site capacity planning.
MIN_FREE_MIB=4096
# Clean images: deploy-cluster.sh site.env time-packages installs signed chrony
# offline. Configure /etc/chrony.conf with the approved server entries, then
# systemctl enable --now chronyd (restart chronyd if updating a running host).
PG_HOST=pg-writer.prod.example.internal
PG_PORT=5432
PG_DATABASE=ambari
PG_USER=ambari
PG_CA=/etc/pki/bigtop/postgres-ca.crt
# These paths are on the ambari-server host. Provision as root, mode 0400 or 0600.
PG_PASSWORD_FILE=/etc/bigtop-deploy/ambari-db.password
# curl netrc containing machine localhost login admin password <current-password>
API_NETRC=/etc/bigtop-deploy/ambari.netrc
# Initial bootstrap uses loopback. After enabling HTTPS use the certified FQDN.
API_BASE=http://localhost:8080
